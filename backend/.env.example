# ─── Application ─────────────────────────────────────────────
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# ─── Security / JWT ──────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── PostgreSQL (async driver) ───────────────────────────────
DATABASE_URL=postgresql+asyncpg://infraansible_user:password@localhost:5432/infraansible

# ─── Redis / Celery ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── MinIO ───────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vulnerability-reports
MINIO_SECURE=false

# ─── Apache Superset ─────────────────────────────────────────
# Server-side API URL (backend → Superset)
SUPERSET_URL=http://localhost:8088
# Browser-facing URL used to frame/load dashboards (localhost in dev; set to the
# public URL when deploying behind a reverse proxy)
SUPERSET_PUBLIC_URL=http://localhost:8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_DASHBOARD_ID=

# ─── File storage ────────────────────────────────────────────
UPLOAD_FOLDER=/var/lib/infraansible/playbooks
REPORTS_DIR=/var/lib/infraansible/reports
ANSIBLE_RUNNER_DIR=/var/lib/infraansible/ansible-runner
ANSIBLE_PRIVATE_KEY_DIR=/var/lib/infraansible/keys

# ─── Backend URL (ansible callbacks) ─────────────────────────
BACKEND_URL=http://0.0.0.0:8000

# ─── CORS ────────────────────────────────────────────────────
# Origins allowed to call the API / open the WebSocket. Add your deployment
# hostname here when going live (Socket.IO rejects unknown origins with 403).
CORS_ORIGINS=http://localhost:5173,http://localhost:9191

# ─── Vulnerability scan schedule (seconds) ───────────────────
VULN_SCAN_INTERVAL_SECONDS=3600
