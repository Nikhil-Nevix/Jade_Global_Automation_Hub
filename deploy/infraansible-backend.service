[Unit]
Description=InfraAnsible Flask Backend (Gunicorn)
After=network.target mysqld.service redis.service
Wants=mysqld.service redis.service

[Service]
User=svc-ansible
Group=svc-ansible
WorkingDirectory=/home/svc-ansible/apps/InfraAnsible/backend
EnvironmentFile=/home/svc-ansible/apps/InfraAnsible/backend/.env
ExecStart=/home/svc-ansible/apps/InfraAnsible/backend/venv/bin/gunicorn \
    --worker-class eventlet \
    --workers 1 \
    --bind 127.0.0.1:5000 \
    --timeout 120 \
    --log-level info \
    --access-logfile /home/svc-ansible/apps/InfraAnsible/backend/access.log \
    --error-logfile /home/svc-ansible/apps/InfraAnsible/backend/error.log \
    run:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
